+use std::collections::hash_map::Entry;
 use std::collections::HashMap;
 
 pub struct Doc {
@@ -24,4 +25,19 @@ impl Store {
     pub fn title(&self, idx: usize) -> &str {
         &self.docs[idx].title
     }
+
+    pub fn summary(&mut self, idx: usize) -> &str {
+        match self.summaries.entry(idx) {
+            Entry::Occupied(e) => e.into_mut(),
+            Entry::Vacant(e) => {
+                let doc = &self.docs[idx];
+                let first = match doc.body.find('.') {
+                    Some(end) => &doc.body[..=end],
+                    None => &doc.body,
+                };
+                self.computed += 1;
+                e.insert(format!("{}: {}", doc.title, first))
+            }
+        }
+    }
 }
