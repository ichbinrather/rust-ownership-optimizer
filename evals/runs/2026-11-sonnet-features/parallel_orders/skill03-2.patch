@@ -36,6 +36,20 @@ impl Pipeline {
 
     /// Returns the total of every order, in the original order.
     pub fn process_all(&self) -> Vec<u64> {
-        self.orders.iter().map(|o| self.total(o)).collect()
+        const THREADS: usize = 4;
+        // Scoped threads borrow `self` and the order slices; no clones or Arc needed.
+        let chunk_len = self.orders.len().div_ceil(THREADS).max(1);
+        std::thread::scope(|s| {
+            let handles: Vec<_> = self
+                .orders
+                .chunks(chunk_len)
+                .map(|chunk| s.spawn(move || chunk.iter().map(|o| self.total(o)).collect::<Vec<u64>>()))
+                .collect();
+            let mut out = Vec::with_capacity(self.orders.len());
+            for h in handles {
+                out.extend(h.join().expect("worker thread panicked"));
+            }
+            out
+        })
     }
 }
