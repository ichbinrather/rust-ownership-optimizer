+    pub fn tick(&mut self) {
+        self.turn += 1;
+        // Index loop: the borrow of players[i] ends before the &mut self calls.
+        for i in 0..self.players.len() {
+            let p = &self.players[i];
+            if p.hp == 0 {
+                let msg = format!("{} is down", p.name);
+                self.log_event(msg);
+            } else if p.hp * 100 < p.max_hp * 30 {
+                let id = p.id;
+                let msg = format!("{} is low on health", p.name);
+                self.log_event(msg);
+                self.heal(id, 25);
+            }
+        }
+    }
