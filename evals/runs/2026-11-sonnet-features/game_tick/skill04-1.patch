+    pub fn tick(&mut self) {
+        self.turn += 1;
+        // Index loop: log_event/heal need &mut self, so no borrow of players may be held.
+        for i in 0..self.players.len() {
+            let p = &self.players[i];
+            let (id, hp, max_hp) = (p.id, p.hp, p.max_hp);
+            if hp == 0 {
+                let msg = format!("{} is down", p.name);
+                self.log_event(msg);
+            } else if hp * 100 < max_hp * 30 {
+                let msg = format!("{} is low on health", p.name);
+                self.log_event(msg);
+                self.heal(id, 25);
+            }
+        }
+    }
